<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:padding="10dp">

    <!-- 책 이미지 (상단 배치) -->
    <ImageView
        android:id="@+id/book_img"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:scaleType="fitCenter"
        android:src="@drawable/root_read_logo"
        android:contentDescription="Book Image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/clear" />

    <!-- 책 제목 -->
    <TextView
        android:id="@+id/main_book_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Book Title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:minHeight="40dp"
        app:layout_constraintTop_toBottomOf="@id/book_img"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 저자 -->
    <TextView
        android:id="@+id/main_book_writer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Writer"
        android:textSize="14sp"
        android:gravity="center"
        android:minHeight="30dp"
        app:layout_constraintTop_toBottomOf="@id/main_book_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 가격 -->
    <TextView
        android:id="@+id/main_book_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Price"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:minHeight="30dp"
        app:layout_constraintTop_toBottomOf="@id/main_book_writer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
