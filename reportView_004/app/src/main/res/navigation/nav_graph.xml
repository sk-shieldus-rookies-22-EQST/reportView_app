<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listFragment">
<!--페이지 to 페이지 동작을 action으로 명시 해줘야 함-->
    <action
        android:id="@+id/action_currentFragment_to_listFragment"
        app:destination="@id/listFragment" />
    <!-- Login Fragment -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.reportview_003.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/login_main">
        <action
            android:id="@+id/action_login_to_list"
            app:destination="@id/listFragment" />
        <action
            android:id="@+id/action_loginFragment_to_findIdFragment"
            app:destination="@id/findIDFragment" />
        <action
            android:id="@+id/action_loginFragment_to_findPwFragment"
            app:destination="@id/findPWFragment" />
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
    </fragment>

    <!-- List Fragment -->
    <fragment
        android:id="@+id/listFragment"
        android:name="com.example.reportview_003.ui.view.ListFragment"
        android:label="BOOKIES"
        tools:layout="@layout/list_main" >
        <action
            android:id="@+id/action_listFragment_to_bookDetailFragment"
            app:destination="@id/bookDetailFragment" />
    </fragment>

    <!-- Book Detail Fragment -->
    <fragment
        android:id="@+id/bookDetailFragment"
        android:name="com.example.reportview_003.ui.view.BookDetailFragment"
        android:label=""
        tools:layout="@layout/book_detail_main" />

    <!-- Board Fragment -->
    <fragment
        android:id="@+id/boardFragment"
        android:name="com.example.reportview_003.ui.board.BoardFragment"
        android:label="게시판"
        tools:layout="@layout/board_main">
        <action
            android:id="@+id/action_boardFragment_to_eachBoardFragment"
            app:destination="@id/eachBoardFragment" />
        <action
            android:id="@+id/action_boardFragment_to_qnaWriterFragment"
            app:destination="@id/qnaWriterFragment" />
    </fragment>

    <fragment
        android:id="@+id/eachBoardFragment"
        android:name="com.example.reportview_003.ui.board.EachBoardFragment"
        android:label="Board"
        tools:layout="@layout/qna_detail_main">
        <action
            android:id="@+id/action_eachBoardFragment_to_qnaWriterFragment"
            app:destination="@id/qnaWriterFragment" />
    </fragment>

    <fragment
        android:id="@+id/purchaseFragment"
        android:name="com.example.reportview_003.ui.purchase.PurchaseFragment"
        android:label="장바구니"
        tools:layout="@layout/purchase_main">
        <action
            android:id="@+id/action_purchaseFragment_to_purchaseProcessFragment"
            app:destination="@id/purchaseProcessFragment" />
    </fragment>

    <fragment
        android:id="@+id/purchaseProcessFragment"
        android:name="com.example.reportview_003.ui.purchase.PurchaseProcessFragment"
        android:label="구매 확인"
        tools:layout="@layout/purchase_process">
        <action
            android:id="@+id/action_purchaseProcessFragment_to_userPurchaseFragment"
            app:destination="@id/userPurchaseFragment" />
    </fragment>

    <fragment
        android:id="@+id/findIDFragment"
        android:name="com.example.reportview_003.ui.auth.FindIDFragment"
        android:label="find id"
        tools:layout="@layout/find_id" >
        <action
            android:id="@+id/action_findIDFragment_to_findPwFragment"
            app:destination="@id/findPWFragment" />
    </fragment>

    <fragment
        android:id="@+id/findPWFragment"
        android:name="com.example.reportview_003.ui.auth.FindPWFragment"
        android:label="find pw"
        tools:layout="@layout/find_pw" >
        <argument
            android:name="data"
            app:argType="string" />
        <action
            android:id="@+id/action_findPWFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.reportview_003.ui.auth.SignupFragment"
        android:label="signup"
        tools:layout="@layout/signup_main" >
        <action
            android:id="@+id/action_signupFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/userinfofragment"
        android:name="com.example.reportview_003.ui.user.UserFragment"
        android:label="내 정보"
        tools:layout="@layout/userinfo_main" />

    <fragment
        android:id="@+id/userPurchaseFragment"
        android:name="com.example.reportview_003.ui.user.UserPurchaseFragment"
        android:label="결제내역"
        tools:layout="@layout/user_purchase_main" />

    <fragment
        android:id="@+id/userBookListFragment"
        android:name="com.example.reportview_003.ui.user.UserBookListFragment"
        android:label="내 서제"
        tools:layout="@layout/user_book_main" />

    <fragment
        android:id="@+id/qnaWriterFragment"
        android:name="com.example.reportview_003.ui.board.QnaWriterFragment"
        android:label="글 작성"
        tools:layout="@layout/qna_write_main" />

    <fragment
        android:id="@+id/reWriterFragment"
        android:name="com.example.reportview_003.ui.board.ReWriteFragment"
        android:label="글 수정"
        tools:layout="@layout/qna_write_main" />
</navigation>
