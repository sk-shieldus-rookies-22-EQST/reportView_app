<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavigationBar" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextColor">@color/black</item> <!-- 텍스트 색상 -->
    </style>
    <!-- Custom DatePickerDialog Style -->
    <style name="CustomDatePickerDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#000000</item> <!-- Accent 색상: 검정 -->
        <item name="android:textColor">#000000</item> <!-- 버튼 텍스트 색상 -->
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomButton</item>
    </style>

    <!-- 버튼 스타일 -->
    <style name="CustomButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">#000000</item> <!-- 버튼 텍스트 색상 -->
    </style>
</resources>