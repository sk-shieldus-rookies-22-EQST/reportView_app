<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="30dp"
    android:orientation="vertical">

    <ListView
        android:id="@+id/purchase_process_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"/>

    <LinearLayout
        android:id="@+id/purchase_process_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.22"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="주문 상품 정보"
                android:gravity="center"
                android:textSize="15dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/purchase_process_totalprice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="total price"
                android:gravity="center"
                android:textSize="15dp"
                android:textStyle="bold"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="보유 포인트"
                android:gravity="center"
                android:textSize="15dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/purchase_process_point"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="point"
                android:gravity="center"
                android:textSize="15dp"
                android:textStyle="bold"/>

        </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="구매 후 잔액"
            android:gravity="center"
            android:textSize="15dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/purchase_process_storePoint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="after purchase"
            android:gravity="center"
            android:textSize="15dp"
            android:textStyle="bold"/>

    </LinearLayout>


    </LinearLayout>

    <Button
        android:id="@+id/purchase_process_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.08"
        android:text="결제"
        android:textSize="20dp"
        android:textColor="@color/white"
        android:textStyle="bold"/>

</LinearLayout>